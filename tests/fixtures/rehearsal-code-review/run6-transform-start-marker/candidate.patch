Subject: [PATCH 1/2] Append uppercase start line to MARKER.md, add marker test

Implements transform-start-marker: appends "THREE-ACTION REHEARSAL
START" after the start line and adds tests/marker.test.mjs asserting
both lines appear in order under node --test.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 MARKER.md             |  1 +
 tests/marker.test.mjs | 10 ++++++++++
 2 files changed, 11 insertions(+)
 create mode 100644 tests/marker.test.mjs

diff --git a/MARKER.md b/MARKER.md
index 4c42e32..155aa32 100644
--- a/MARKER.md
+++ b/MARKER.md
@@ -1 +1,2 @@
 three-action rehearsal start
+THREE-ACTION REHEARSAL START
diff --git a/tests/marker.test.mjs b/tests/marker.test.mjs
new file mode 100644
index 0000000..bf7631c
--- /dev/null
+++ b/tests/marker.test.mjs
@@ -0,0 +1,10 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+
+test("MARKER.md contains the start and transformed lines in order", () => {
+  const lines = readFileSync("MARKER.md", "utf8").split("\n");
+  assert.equal(lines.at(-1), "");
+  lines.pop();
+  assert.deepEqual(lines, ["three-action rehearsal start", "THREE-ACTION REHEARSAL START"]);
+});

