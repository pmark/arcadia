{
  "name": "@pmark/arcadia",
  "version": "0.1.0",
  "description": "Local-first project operating system CLI for creative and software work.",
  "type": "module",
  "private": true,
  "bin": {
    "arcadia": "dist/src/cli.js"
  },
  "exports": {
    "./intelligence/client": {
      "types": "./dist/src/intelligence/client/index.d.ts",
      "import": "./dist/src/intelligence/client/index.js"
    },
    "./intelligence/contracts": {
      "types": "./dist/src/intelligence/contracts.d.ts",
      "import": "./dist/src/intelligence/contracts.js"
    }
  },
  "files": [
    "dist/src/intelligence/client",
    "dist/src/intelligence/contracts.js",
    "dist/src/intelligence/contracts.d.ts",
    "dist/src/intelligence/contracts.js.map",
    "dist/src/intelligence/contracts.d.ts.map",
    "dist/src/intelligence/types.js",
    "dist/src/intelligence/types.d.ts",
    "dist/src/intelligence/types.js.map",
    "dist/src/intelligence/types.d.ts.map",
    "README.md"
  ],
  "scripts": {
    "postinstall": "mise exec -- pnpm rebuild better-sqlite3",
    "build": "pnpm lint && tsc -p tsconfig.json && pnpm --filter arcadia-discord-bot build",
    "test": "vitest run",
    "lint": "eslint src test tests scripts apps/dashboard apps/discord-bot",
    "lint:fix": "eslint --fix src test tests scripts apps/dashboard apps/discord-bot",
    "arcadia": "mise exec -- node --import tsx src/cli.ts",
    "dashboard": "pnpm --filter arcadia-dashboard dev",
    "logs": "bash scripts/logs.sh",
    "dashboard:build": "pnpm --filter arcadia-dashboard build",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "verify:package-boundary": "node scripts/verify-intelligence-package-exports.mjs",
    "bridge:worktree": "node scripts/bridge-worktree-deps.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "dotenv": "^16.6.1",
    "p-queue": "^9.3.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.25",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.7.0"
}
