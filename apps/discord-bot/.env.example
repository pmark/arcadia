ARCADIA_WORKSPACE=/absolute/path/to/arcadia-workspace
DISCORD_BOT_TOKEN=replace-me
DISCORD_CLIENT_ID=replace-me
DISCORD_GUILD_ID=replace-me
DISCORD_CHANNEL_ID=replace-me

# Optional
# ARCADIA_CLI_PATH=/absolute/path/to/arcadia
# ARCADIA_DASHBOARD_URL=http://arcadia-1.alpine-rattlesnake.ts.net:3020  # Tailscale MagicDNS hostname; works from a phone. A LAN IP works too, but drifts.
# ARCADIA_DISCORD_POLL_INTERVAL_SECONDS=60
# Channels an agent's `arcadia ping --channel <alias>` may reach: alias=<channel id>,...
# DISCORD_PING_CHANNELS=actions=123456789012345678
# Routes proactive notifications by category: alerts, briefings, log. Unset = the default channel.
# DISCORD_CATEGORY_CHANNELS=alerts=345678901234567890,briefings=456789012345678901,log=567890123456789012
